{
  "events": [
    {
      "id": "audition",
      "name": "The Audition",
      "description": "A major entertainment company is holding open auditions. This could be a second chance—or another trap.",
      "trigger": {
        "day": 7,
        "timeOfDay": "noon"
      },
      "choices": [
        {
          "id": "audition_1",
          "text": "We should all go together. Strength in numbers.",
          "consequences": [
            { "target": "meter", "stat": "teamCohesion", "value": 15 },
            { "target": "meter", "stat": "exposureRisk", "value": 20 }
          ]
        },
        {
          "id": "audition_2",
          "text": "Only those who want to go should go. No pressure.",
          "consequences": [
            { "target": "meter", "stat": "teamCohesion", "value": -5 },
            { "target": "meter", "stat": "trust", "value": 10 }
          ]
        },
        {
          "id": "audition_3",
          "text": "This is too risky. We can't put ourselves out there like that.",
          "consequences": [
            { "target": "meter", "stat": "moneyPressure", "value": 15 }
          ]
        }
      ],
      "meterEffects": [
        { "target": "meter", "stat": "energy", "value": -20 }
      ]
    },
    {
